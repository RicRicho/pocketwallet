# PocketWallet is non-custodial and client-side only — the setup flow needs NO
# server secrets. This file exists for the *next* build (balances / RPC), where
# you'll add a read-only RPC endpoint. Never put a private key or seed here.

# Public JSON-RPC endpoint used to read balances (read-only, safe to ship).
# NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional chain id the wallet defaults to (1 = Ethereum mainnet).
# NEXT_PUBLIC_CHAIN_ID=1
